# Copy to apps/<zone>/.env.local (or export before `pnpm dev`). Everything is optional:
# with nothing set, the POC runs fully locally (Segment SDK → local collector, rrweb replay, DuckDB).

# ── Segment ──────────────────────────────────────────────────────────────────
# Real write key → events go to api.segment.io (then Segment → S3/Snowflake).
NEXT_PUBLIC_SEGMENT_WRITE_KEY=
# Also mirror every event to the local collector so the insights dashboard keeps working.
NEXT_PUBLIC_SEGMENT_MIRROR_LOCAL=false

# ── New Relic Browser + Session Replay ───────────────────────────────────────
# From New Relic → Browser → (app) → Application settings. Leave empty to disable.
NEXT_PUBLIC_NEW_RELIC_LICENSE_KEY=
NEXT_PUBLIC_NEW_RELIC_APPLICATION_ID=
NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID=
NEXT_PUBLIC_NEW_RELIC_TRUST_KEY=
NEXT_PUBLIC_NEW_RELIC_AGENT_ID=

# ── Local pipeline ───────────────────────────────────────────────────────────
# Where the browser sends events/replay chunks. Defaults to <current origin>/api (the shell zone).
NEXT_PUBLIC_COLLECTOR_URL=
# rrweb session replay: on (default) | off
NEXT_PUBLIC_REPLAY=on
# Log every tracked event to the browser console.
NEXT_PUBLIC_TRACKER_DEBUG=false
# Where the collector writes NDJSON and the dashboard reads it. Defaults to <repo>/.data
POC_DATA_DIR=

# ── Multi-zone routing (shell rewrites) ──────────────────────────────────────
ORDERS_ZONE_URL=http://localhost:3001
INSIGHTS_ZONE_URL=http://localhost:3002
